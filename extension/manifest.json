{
  "manifest_version": 3,
  "name": "Meet Notes Recorder",
  "version": "0.1.0",
  "description": "Records Google Meet audio and video from within the meeting tab and generates AI meeting notes.",
  "minimum_chrome_version": "109",
  "permissions": ["tabCapture", "activeTab", "offscreen", "storage"],
  "host_permissions": ["https://meet.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
